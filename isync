#!/bin/bash
# =======================================================================================
# ISync Unified Launcher
# =======================================================================================
# Usage:
#   ./isync                 # Start ISync locally
#   ./isync start           # Start ISync locally (Explicit)
#   ./isync stop            # Stop local ISync services
#   ./isync restart         # Restart local ISync services
#   ./isync ssh <host>      # Connect to remote ISync via SSH (Starts & Tunnels)
#   ./isync ssh --list      # List saved remote servers
#   ./isync help            # Show help menu
# =======================================================================================

# --- Configuration ---------------------------------------------------------------------
LOCAL_FRONTEND_PORT=5173
LOCAL_BACKEND_PORT=8000
REMOTE_FRONTEND_PORT=5173
REMOTE_BACKEND_PORT=8000
CONFIG_EXPORT_FILE="$HOME/.isync_servers.json"

# --- Styling ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

print_header() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  ISync Unified Launcher${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

print_usage() {
    print_header
    echo -e "Usage: $0 [COMMAND] [OPTIONS]"
    echo ""
    echo "Local Commands:"
    echo "  start (default)    Start ISync locally (Backend + Frontend)"
    echo "  stop               Stop all running local ISync processes"
    echo "  restart            Restart local ISync"
    echo ""
    echo "Remote Commands:"
    echo "  ssh <host>         Connect to remote ISync server (Auto-start & Tunnel)"
    echo "                     <host> can be 'user@ip' or a saved alias"
    echo "  ssh --list         List saved remote servers"
    echo "  ssh --stop <host>  Stop ISync on remote server"
    echo ""
    echo "Examples:"
    echo "  ./isync"
    echo "  ./isync ssh myserver"
    echo "  ./isync ssh user@192.168.1.50"
    echo ""
}

# --- Browser Opener --------------------------------------------------------------------
open_browser() {
    local url="http://localhost:${LOCAL_FRONTEND_PORT}"
    # Wait for service to be up
    local max_wait=30
    local waited=0
    
    # Simple check if port is open locally
    while ! nc -z localhost $LOCAL_FRONTEND_PORT 2>/dev/null; do
        if [ $waited -ge $max_wait ]; then break; fi
        sleep 1
        waited=$((waited + 1))
    done

    echo -e "${YELLOW}Opening browser at ${url}...${NC}"
    if command -v xdg-open &> /dev/null; then
        xdg-open "$url" 2>/dev/null &
    elif grep -qi microsoft /proc/version 2>/dev/null; then
        # WSL - use Windows browser
        cmd.exe /c start "$url" 2>/dev/null &
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        open "$url"
    else
        echo "Please open $url manually."
    fi
}

# --- Local Operations ------------------------------------------------------------------
start_local() {
    print_header
    
    # 1. Check if already running (Comprehensive Port & Process check)
    local backend_running=false
    local frontend_running=false
    local ghost_ports=""
    
    if pgrep -f 'uvicorn.*backend.main' > /dev/null 2>&1; then backend_running=true; fi
    if pgrep -f 'vite.*5173' > /dev/null 2>&1 || pgrep -f 'node.*vite' > /dev/null 2>&1; then frontend_running=true; fi
    
    if command -v lsof &> /dev/null; then
        for port in 5173 5174 8000; do
            if lsof -ti:$port > /dev/null 2>&1; then
                [ -n "$ghost_ports" ] && ghost_ports="$ghost_ports, $port" || ghost_ports="$port"
            fi
        done
    fi

    if [ "$backend_running" = true ] || [ "$frontend_running" = true ] || [ -n "$ghost_ports" ]; then
        echo -e "${YELLOW}⚠ ISync is already running or ports are occupied:${NC}"
        [ "$backend_running" = true ] && echo -e "  Backend:  ${GREEN}Running${NC}" || echo -e "  Backend:  ${RED}Stopped${NC}"
        [ "$frontend_running" = true ] && echo -e "  Frontend: ${GREEN}Running${NC}" || echo -e "  Frontend: ${RED}Stopped${NC}"
        [ -n "$ghost_ports" ] && echo -e "  ${YELLOW}Ghost processes on ports: $ghost_ports${NC}"
        
        echo ""
        echo "Options:"
        echo "  [R] Restart - Stop existing and start fresh"
        echo "  [O] Open browser only (don't restart)"
        echo "  [Q] Quit"
        echo ""
        read -p "Choice [R/O/Q]: " choice
        
        case "${choice,,}" in
            r|restart)
                echo -e "${YELLOW}Stopping existing ISync...${NC}"
                pkill -f 'uvicorn.*backend.main' 2>/dev/null
                pkill -f 'vite' 2>/dev/null
                pkill -f 'node.*vite' 2>/dev/null
                if command -v lsof &> /dev/null; then
                    for port in 5173 5174 8000; do
                        local port_pid=$(lsof -t -i:$port 2>/dev/null)
                        [ -n "$port_pid" ] && kill -9 $port_pid 2>/dev/null
                    done
                fi
                sleep 2
                echo -e "${GREEN}Stopped. Starting fresh...${NC}"
                ;;
            o|open)
                open_browser
                exit 0
                ;;
            q|quit|*)
                exit 0
                ;;
        esac
    fi

    # 2. Activate Virtual Environment
    if [ -d "venv" ]; then
        source venv/bin/activate
    elif [ -d ".venv" ]; then
        source .venv/bin/activate
    else
        echo -e "${RED}Error: Virtual environment not found (venv or .venv).${NC}"
        echo "Run './install.sh' or create one manually."
        exit 1
    fi

    # 3. Start Backend
    mkdir -p logs
    echo -e "${BLUE}Starting Backend on port $LOCAL_BACKEND_PORT...${NC}"
    uvicorn backend.main:app --host 0.0.0.0 --port $LOCAL_BACKEND_PORT > logs/backend.log 2>&1 &
    BACKEND_PID=$!
    echo "Backend PID: $BACKEND_PID"

    # 4. Start Frontend
    echo -e "${BLUE}Starting Frontend on port $LOCAL_FRONTEND_PORT...${NC}"
    cd frontend
    npm run dev -- --host 0.0.0.0 --port $LOCAL_FRONTEND_PORT > ../logs/frontend.log 2>&1 &
    FRONTEND_PID=$!
    cd ..
    echo "Frontend PID: $FRONTEND_PID"
    
    echo -e "${GREEN}Services started.${NC}"
    
    # 5. Open Browser and Wait
    (sleep 2 && open_browser) &
    
    # Wait loop
    trap "stop_local" INT TERM
    wait $BACKEND_PID $FRONTEND_PID
}

stop_local() {
    echo -e "${YELLOW}Stopping ISync...${NC}"
    pkill -f "uvicorn.*backend.main" || true
    pkill -f "vite" || true
    echo -e "${GREEN}Stopped.${NC}"
}

# --- Remote Operations -----------------------------------------------------------------
remote_ssh() {
    local host="$1"
    local path="${2:-/opt/isync}"
    
    if [ -z "$host" ]; then
        echo -e "${RED}Error: Host Required.${NC}"
        echo "Usage: ./isync ssh <user@host>"
        exit 1
    fi
    
    print_header
    echo -e "${CYAN}Connecting to remote ISync at ${host}...${NC}"

    # 1. Check and Start Remote ISync via SSH
    # We send a composite command: check env -> check running -> start tmux if needed
    local remote_cmd="
        if [ ! -d '$path' ]; then echo 'PATH_ERROR'; exit 1; fi;
        cd $path;
        if ! tmux has-session -t isync 2>/dev/null; then
            tmux new-session -d -s isync './isync start';
            echo 'STARTED_TMUX';
            sleep 5; # Give it a moment to boot
        else
            echo 'ALREADY_RUNNING';
        fi
    "
    
    echo -e "${YELLOW}Checking/Starting remote service...${NC}"
    local output
    output=$(ssh -o ConnectTimeout=5 "$host" "$remote_cmd")
    
    if [[ "$output" == *"PATH_ERROR"* ]]; then
        echo -e "${RED}ISync not found at $path on remote host.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}Remote checks passed.${NC}"
    
    # 2. Start Tunnel
    echo -e "${BLUE}Establishing secure tunnel...${NC}"
    echo -e "${GREEN}ISync is accessible at http://localhost:$LOCAL_FRONTEND_PORT${NC}"
    
    (sleep 2 && open_browser) &

    # SSH Tunnel (Blocking)
    ssh -N \
        -L ${LOCAL_FRONTEND_PORT}:localhost:${REMOTE_FRONTEND_PORT} \
        -L ${LOCAL_BACKEND_PORT}:localhost:${REMOTE_BACKEND_PORT} \
        "$host"
}

remote_list() {
    echo -e "${YELLOW}Saved Remote Servers:${NC}"
    # Try to fetch from local config if possible, else just show file
    if [ -f "$CONFIG_EXPORT_FILE" ]; then
        cat "$CONFIG_EXPORT_FILE"
    else
        echo "No saved servers found."
    fi
}

start_isync_remote_service() {
    # This function checks if we are running INSIDE the remote via SSH/Tmux
    # It just calls start_local but ensures it binds 0.0.0.0
    start_local
}

# --- Main Dispatch ---------------------------------------------------------------------

# If running inside the container/remote via this script, handle simple start
CMD="${1:-start}"

case "$CMD" in
    start)
        start_local
        ;;
    stop)
        stop_local
        ;;
    restart)
        stop_local
        sleep 1
        start_local
        ;;
    ssh)
        SUB_CMD="${2:-}"
        if [ "$SUB_CMD" == "--list" ]; then
            remote_list
        elif [ -z "$SUB_CMD" ]; then
            echo -e "${RED}Missing Host.${NC}"
            echo "Usage: ./isync ssh <host>"
        else
            remote_ssh "$SUB_CMD"
        fi
        ;;
    help|--help|-h)
        print_usage
        ;;
    *)
        echo -e "${RED}Unknown command: $CMD${NC}"
        print_usage
        exit 1
        ;;
esac
